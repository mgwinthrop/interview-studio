diff --git a/.factory/gates.conf b/.factory/gates.conf
--- a/.factory/gates.conf
+++ b/.factory/gates.conf
@@ -1,13 +1,15 @@
 # Required gates by level. A required gate that cannot run makes the verdict
 # MISCONFIGURED (exit 2), never GREEN. Space-separated gate names.
 #
-# Available names: types lint test build audit mutation architecture
+# Available names: types lint test build e2e audit mutation architecture
 # Add build or mutation when the repository has a real command for it.

 # interview-studio: the root package.json fans each gate out to apps/backend and
-# apps/frontend (typecheck, lint, test, build, audit). Playwright e2e stays in CI,
-# because it needs a browser download and free ports 3000/3001.
+# apps/frontend (typecheck, lint, test, build, e2e, audit). e2e runs the Playwright
+# browser tests against the mock backend. It needs the Chromium build that the pinned
+# @playwright/test expects and free ports 3000 and 3001; when either is missing the gate
+# is skipped, so a required e2e makes the verdict MISCONFIGURED, never GREEN.
 REQUIRED_FAST="types lint"
-REQUIRED_FULL="types lint test build"
-REQUIRED_DEEP="types lint test build audit architecture"
+REQUIRED_FULL="types lint test build e2e"
+REQUIRED_DEEP="types lint test build e2e audit architecture"

