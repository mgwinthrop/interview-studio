# Blank values mean unset (defaults apply).
DATABASE_URL=file:./local.db
# PROFILE=cloud needs both API keys; PROFILE=mock needs none.
PROFILE=cloud
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Blank uses the default voice (pNInz6obpgDQGcFmaJgB)
ELEVENLABS_VOICE_ID=
ALLOWED_ORIGIN=http://localhost:3000
# Non-loopback HOST requires AUTH_TOKEN
HOST=127.0.0.1
PORT=3001
AUTH_TOKEN=
DEBUG_LOG_TEXT=
RETENTION_DAYS=
# Show filler-word counts ("um", "uh") in reports: 1 or true turns it on; anything else is off.
# Leave off until the maintainer has checked, with a real conversation, that the speech-to-text
# keeps filler words. Counts are stored either way; this only controls whether reports show them.
REPORT_FILLER_COUNTS=
# Optional speech fallback (voice ID required if key is set)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
