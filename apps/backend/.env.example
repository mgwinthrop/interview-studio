# Blank values mean unset (defaults apply).
DATABASE_URL=file:./local.db
# PROFILE=cloud needs both API keys; PROFILE=mock needs none.
PROFILE=cloud
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Blank uses the default voice (pNInz6obpgDQGcFmaJgB)
ELEVENLABS_VOICE_ID=
ALLOWED_ORIGIN=http://localhost:3000
# Non-loopback HOST requires AUTH_TOKEN
HOST=127.0.0.1
PORT=3001
AUTH_TOKEN=
DEBUG_LOG_TEXT=
RETENTION_DAYS=
# Optional speech fallback (voice ID required if key is set)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
