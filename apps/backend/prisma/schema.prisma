// prisma/schema.prisma
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Session {
  id              String             @id @default(uuid())
  ownerId         String             @default("local")
  // Pre-existing rows keep their old topic id here and have a null snapshot.
  interviewerId   String
  // The full interviewer definition at session start (JSON); null on sessions from before interviewers.
  interviewerJson String?
  status          String             @default("active")
  phase           String             @default("intro")
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  turns           ConversationTurn[]
  report          Report?

  @@index([ownerId])
}

model ConversationTurn {
  id          String   @id @default(uuid())
  sessionId   String
  role        String
  content     String
  phase       String
  timestamp   DateTime @default(now())
  // JSON.stringify(TurnMetrics) for user turns; null when not measured and on older rows.
  metricsJson String?
  session     Session  @relation(fields: [sessionId], references: [id])
}

model Report {
  id                String   @id @default(uuid())
  sessionId         String   @unique
  summary           String
  strengthsJson     String // JSON.stringify({ area, evidence }[])
  improvementsJson  String // JSON.stringify({ area, suggestion }[])
  highlightsJson    String // JSON.stringify(string[])
  overallAssessment String
  generatedAt       DateTime @default(now())
  // JSON of the v2 report; null on reports from before v2, which use the columns above.
  reportJson        String?
  session           Session  @relation(fields: [sessionId], references: [id])
}

model Interviewer {
  id             String   @id
  ownerId        String
  source         String // "preset" | "custom"
  name           String
  purpose        String
  version        Int
  definitionJson String // JSON.stringify(InterviewerDefinition)
  createdAt      DateTime
  updatedAt      DateTime

  @@index([ownerId])
}

// One row per LLM API call: numbers and ids only, never prompts, transcripts or responses.
model LlmUsage {
  id               String   @id @default(uuid())
  ownerId          String
  // Null for calls outside a stored session (designer, trial, drafts).
  sessionId        String?
  at               DateTime @default(now())
  feature          String // "conversation" | "report" | "designer-draft" | "persona-draft"
  provider         String
  model            String
  inputTokens      Int?
  outputTokens     Int?
  // Estimated at record time from the owner's stored model prices (ModelPrice); null when the model has no price.
  estimatedCostUsd Float?

  @@index([ownerId])
}

// One row per owner: the settings they changed, as JSON (model ids, numbers, format ids only).
// Absent keys fall back to the built-in defaults in settings.ts.
model AppSettings {
  ownerId    String   @id
  valuesJson String
  updatedAt  DateTime @updatedAt
}

// The owner's Claude prices in USD per million tokens, entered by hand; used for cost estimates.
model ModelPrice {
  ownerId       String
  model         String
  inputPerMtok  Float
  outputPerMtok Float
  asOf          String // YYYY-MM-DD
  updatedAt     DateTime @updatedAt

  @@id([ownerId, model])
}
